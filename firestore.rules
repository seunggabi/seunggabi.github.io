rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Read marks: one document per signed-in user, users/{uid} = { reads: [post paths] }.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['reads'])
        && request.resource.data.reads is list
        && request.resource.data.reads.size() <= 1000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
